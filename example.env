
FORM_RECOGNIZER_ENDPOINT="xxx"
FORM_RECOGNIZER_KEY="xxx"


COSMOS_HOST = "xxx"
COSMOS_MASTER_KEY = "xxxx"
COSMOS_DATABASE_ID = "xxx"
COSMOS_CONTAINER_ID = "xxx"



AZURE_OPENAI_DEPLOYMENT_NAME="xxx"
AZURE_OPENAI_ENDPOINT="xxx"
AZURE_OPENAI_API_KEY="xxx"

# Proposal workflow: use the Azure OpenAI Responses API with the Foundry deployment.
# Usually this is your Azure OpenAI endpoint plus /openai/v1. Set this only when the
# project endpoint shown in Foundry differs from the resource endpoint above.
AZURE_OPENAI_RESPONSES_ENDPOINT="https://your-resource.openai.azure.com/openai/v1"

# Preferred for a serverless deployment created in Microsoft Foundry.
FOUNDRY_PROJECT_ENDPOINT="https://your-resource.services.ai.azure.com/api/projects/your-project"

# Key Vault is optional locally and recommended on the VM. The backend falls
# back to .env values when no managed identity/Azure CLI login is available.
AZURE_KEY_VAULT_URI="https://your-vault-name.vault.azure.net/"
# Local-only fallback when Azure CLI is unavailable. Set true for a one-off
# browser sign-in; keep false for the VM where managed identity is preferred.
AZURE_USE_INTERACTIVE_BROWSER="false"
# Use this instead when the backend process cannot launch the browser itself.
AZURE_USE_DEVICE_CODE="false"

# Used for scanned PDFs or documents without native extractable text.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT="https://your-resource.cognitiveservices.azure.com/"
AZURE_DOCUMENT_INTELLIGENCE_KEY="xxx"

AZURE_SEARCH_ENDPOINT="xxx"
AZURE_SEARCH_KEY="xxx" 
AZURE_SEARCH_INDEX_KB="xxx"

STORAGE_ACCOUNT_NAME="xxx"
STORAGE_ACCOUNT_KEY="xxx"
STORAGE_ACCOUNT_CONTAINER_RFP="xxx"



BING_SEARCH_KEY="xxx"
BING_SEARCH_ENDPOINT="xxx"


BING_SEARCH_ENABLED="false"
KNOWLEDGE_BASE_SEARCH_ENABLED="false"
